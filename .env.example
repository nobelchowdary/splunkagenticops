# Environment Variables for SentinelFlow

# === Splunk Configuration ===
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=changeme
SPLUNK_SCHEME=https

# Splunk MCP Server
SPLUNK_MCP_URL=http://localhost:8088
SPLUNK_MCP_TOKEN=your_mcp_token_here

# === LLM Configuration ===
# Choose one: anthropic or openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# Model selection
LLM_MODEL=claude-sonnet-4-20250514

# === Splunk Hosted Models ===
# Foundation-Sec-8B endpoint (via Splunk AI Toolkit)
FOUNDATION_SEC_ENDPOINT=http://localhost:8000/api/models/foundation-sec
# Cisco Deep Time Series Model endpoint
CISCO_DTSM_ENDPOINT=http://localhost:8000/api/models/cisco-dtsm

# === Application Settings ===
BACKEND_PORT=8000
FRONTEND_PORT=3000
WEBSOCKET_PORT=8000

# === Database ===
DATABASE_URL=sqlite:///./sentinelflow.db

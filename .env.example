# Environment Variables for SentinelFlow
# Copy this file to .env and fill in your credentials

# === Splunk Configuration ===
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_USERNAME=your_splunk_username
SPLUNK_PASSWORD=your_splunk_password
SPLUNK_SCHEME=https

# Splunk HEC (HTTP Event Collector) — for writing notable events
SPLUNK_HEC_URL=http://localhost:8088
SPLUNK_HEC_TOKEN=your_hec_token_here

# Splunk MCP Server (optional — falls back to SDK if empty)
SPLUNK_MCP_URL=http://localhost:8088
SPLUNK_MCP_TOKEN=

# === LLM Configuration ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model selection (Claude Sonnet 4 recommended)
LLM_MODEL=claude-sonnet-4-6

# === Splunk Hosted Models (optional — graceful fallback if unavailable) ===
FOUNDATION_SEC_ENDPOINT=
CISCO_DTSM_ENDPOINT=

# === Application Settings ===
BACKEND_PORT=8000
FRONTEND_PORT=3000
